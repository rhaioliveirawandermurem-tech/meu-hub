-- ==================== CONFIGURAÇÕES ====================
local COR_NEON = Color3.fromRGB(0, 255, 120)
local COR_FUNDO = Color3.fromRGB(15, 15, 15)
local COR_FUNDO_2 = Color3.fromRGB(25, 30, 25)

-- ==================== SERVIÇOS ====================
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local LP = Players.LocalPlayer

-- ==================== LOCALIZA O DINO HUB ====================
local hubGui, scrollFrame = nil, nil
for _, gui in ipairs(CoreGui:GetChildren()) do
    if gui.Name == "DinoHub" then
        hubGui = gui
        for _, desc in ipairs(gui:GetDescendants()) do
            if desc:IsA("ScrollingFrame") then
                scrollFrame = desc
                break
            end
        end
        break
    end
end

if not hubGui or not scrollFrame then
    warn("❌ Dino Hub não encontrado! Carregue o Dino Hub primeiro.")
    return
end

print("✅ Dino Hub encontrado! Iniciando Auto Kokusen...")
-- ==================== VARIÁVEIS GLOBAIS ====================
local kokusenAtivo = false
local loopKokusen = nil
local kokusenRange = 25          -- Alcance em studs
local kokusenDelay = 0.15        -- Delay entre cada combo
local cachedRemotes = nil

-- ==================== DETECÇÃO DE ALVO ====================
local function AcharAlvo(range)
    local char = LP.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local closest, dist = nil, range or kokusenRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = p
                end
            end
        end
    end
    return closest
end

-- ==================== INPUT HELPERS ====================
local function PressKey(key, hold)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, key, false, game)
        task.wait(hold or 0.03)
        vim:SendKeyEvent(false, key, false, game)
    end)
end

local function ClickMouse()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.02)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- ==================== PROCURA REMOTES DE KOKUSEN ====================
local function AcharRemotesKokusen()
    local remotes = {}
    pcall(function()
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                local n = string.lower(obj.Name)
                if string.find(n, "kokusen") or string.find(n, "black")
                or string.find(n, "flash") or string.find(n, "attack")
                or string.find(n, "m1") or string.find(n, "combat")
                or string.find(n, "punch") then
                    table.insert(remotes, obj)
                end
            end
        end
    end)
    return remotes
end

-- ==================== ATIVA ESTADO KOKUSEN ====================
local function AtivarModoKokusen()
    local char = LP.Character
    if not char then return end

    pcall(function()
        char:SetAttribute("Kokusen", true)
        char:SetAttribute("BlackFlash", true)
        char:SetAttribute("AutoKokusen", true)

        local stats = char:FindFirstChild("Stats")
                   or char:FindFirstChild("Values")
                   or char:FindFirstChild("Data")
        if stats then
            for _, name in ipairs({"Kokusen", "BlackFlash", "Chain"}) do
                local v = stats:FindFirstChild(name)
                if v then pcall(function() v.Value = true end) end
            end
        end
    end)
end
-- ==================== EXECUTA O COMBO ====================
local function ExecutarKokusen(alvo)
    if not alvo or not alvo.Character then return end

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local tRoot = alvo.Character:FindFirstChild("HumanoidRootPart")
    local tHum  = alvo.Character:FindFirstChildOfClass("Humanoid")
    if not tRoot or not tHum or tHum.Health <= 0 then return end

    local dist = (tRoot.Position - root.Position).Magnitude
    if dist > kokusenRange then return end

    -- Olha pro alvo
    root.CFrame = CFrame.new(root.Position, tRoot.Position)

    -- Ativa Kokusen
    AtivarModoKokusen()

    -- Dispara remotes (se existirem)
    if not cachedRemotes then
        cachedRemotes = AcharRemotesKokusen()
    end
    for _, r in ipairs(cachedRemotes or {}) do
        pcall(function()
            if r:IsA("RemoteEvent") then
                r:FireServer()
            elseif r:IsA("RemoteFunction") then
                r:InvokeServer()
            end
        end)
    end

    -- M1 (click)
    ClickMouse()

    -- Teclas de skill
    PressKey(Enum.KeyCode.R)
    task.wait(0.04)
    PressKey(Enum.KeyCode.F)
    task.wait(0.04)

    -- Skills numeradas
    PressKey(Enum.KeyCode.One)
    task.wait(0.03)
    PressKey(Enum.KeyCode.Two)
end

-- ==================== INICIAR / PARAR ====================
local function IniciarKokusen()
    kokusenAtivo = true
    cachedRemotes = AcharRemotesKokusen()

    loopKokusen = task.spawn(function()
        while kokusenAtivo do
            local alvo = AcharAlvo()
            if alvo then
                pcall(function() ExecutarKokusen(alvo) end)
            end
            task.wait(kokusenDelay)
        end
    end)

    print("⚡ Auto Kokusen ATIVADO")
end

local function PararKokusen()
    kokusenAtivo = false
    if loopKokusen then
        task.cancel(loopKokusen)
        loopKokusen = nil
    end
    print("⚡ Auto Kokusen DESATIVADO")
end
